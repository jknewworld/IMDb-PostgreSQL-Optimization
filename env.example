# Copy this file to .env and replace the example password.
POSTGRES_DB=imdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_before_use
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONNECT_TIMEOUT=10
POSTGRES_APPLICATION_NAME=imdb_project
POSTGRES_SHM_SIZE=512mb

IMDB_DATA_DIR=./data
IMDB_QUEUE_NAME=imdb_ingest
IMDB_PRODUCER_BATCH_SIZE=500
IMDB_PRODUCER_COMMIT_EVERY_BATCHES=10
IMDB_PRODUCER_HIGH_WATER=20000
IMDB_PRODUCER_LOW_WATER=10000
IMDB_BACKPRESSURE_POLL_INTERVAL=0.5
IMDB_CONSUMER_BATCH_SIZE=100
IMDB_VISIBILITY_TIMEOUT="30 seconds"
IMDB_POLL_INTERVAL=1
IMDB_MAX_EMPTY_POLLS=0
IMDB_CONNECT_RETRIES=10
IMDB_RECONNECT_DELAY=2
IMDB_CONSUMER_PURGE_DONE=true
IMDB_PURGE_DONE_OLDER_THAN="2 minutes"
IMDB_PURGE_DONE_EVERY_BATCHES=20
IMDB_PURGE_DONE_LIMIT=5000
IMDB_PROGRESS_EVERY=10000
IMDB_MAX_ROWS_PER_FILE=0
IMDB_INCLUDE_SOURCE_METADATA=false
IMDB_MALFORMED_LOG=./logs/malformed_rows.log
LOG_LEVEL=INFO
